<Window x:Class="GestorPagos.UI.Views.CorrectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Corregir Pago" Height="420" Width="450"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Border BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="2">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- Título -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Corregir Pago" Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                <TextBlock Text="Modifique la cédula correcta para re-conciliar con la API"
                           Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            
            <!-- Información del pago (solo lectura) -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="INFORMACIÓN DEL PAGO" FontWeight="Bold" Foreground="Gray" FontSize="10" Margin="0,0,0,8"/>
                
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="ID Pago" Text="{Binding IdCorto}" IsReadOnly="True" Margin="0,0,4,0" />
                    <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Monto" Text="{Binding Monto, StringFormat=$ {0:N0}}" IsReadOnly="True" Margin="4,0,0,0" />
                </Grid>
                
                <TextBox materialDesign:HintAssist.Hint="Cédula Original (BANCO)" Text="{Binding CedulaCliente}" IsReadOnly="True" Margin="0,0,0,8" 
                         Background="#FFF3E0" />
                
                <TextBox materialDesign:HintAssist.Hint="Convenio" Text="{Binding Convenio}" IsReadOnly="True" Margin="0,0,0,8" />
                
                <TextBox materialDesign:HintAssist.Hint="Error" Text="{Binding Error}" IsReadOnly="True" Margin="0,0,0,8"
                         Foreground="Red" />
                
                <TextBox materialDesign:HintAssist.Hint="Observación" Text="{Binding Observacion}" IsReadOnly="True" Margin="0,0,0,16" 
                         TextWrapping="Wrap" MaxHeight="50" />
                
                <!-- Campo editable -->
                <TextBlock Text="CORRECCIÓN" FontWeight="Bold" Foreground="Green" FontSize="10" Margin="0,0,0,8"/>
                
                <TextBox x:Name="txtCedulaCorrecta" 
                         materialDesign:HintAssist.Hint="Cédula Correcta (EDITAR AQUÍ)" 
                         Text="{Binding CedulaCorrecta, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,8"
                         FontSize="16"
                         FontWeight="Bold"
                         Background="#E8F5E9"
                         materialDesign:HintAssist.FloatingScale="0.8"/>
                
                <TextBlock Text="Ingrese la cédula correcta del cliente. Este pago se re-conciliará con la API."
                           Foreground="Gray" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
            
            <!-- Botones -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancelar" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0" />
                <Button Content="Guardar Corrección" IsDefault="True" Click="Save_Click" Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
