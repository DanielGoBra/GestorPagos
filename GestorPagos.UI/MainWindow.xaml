<Window x:Class="GestorPagos.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Gestor de Pagos - Inklusiva Microfinanzas S.A.S" Height="750" Width="1600"
        Icon="pack://application:,,,/inklusivapp_logo.png"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Fondo.jpeg" Stretch="UniformToFill" Opacity="0.25"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Import Card replaced by Header Image -->
        <!-- Stretch="UniformToFill" para evitar deformación "aplastada" -->
        <Image Grid.Row="0" Source="pack://application:,,,/marco.jpg" Stretch="UniformToFill" Height="120" Margin="0,0,0,8" />

        <!-- Status Bar con colores suaves y semitransparentes -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,8">
            <TextBlock Text="Convenio: " Style="{StaticResource MaterialDesignBody2TextBlock}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ConvenioDetectado}" Style="{StaticResource MaterialDesignBody1TextBlock}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="4,0,12,0" />
            
            <Border Background="#40E3F2FD" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text=" " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Pagos.Count}" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            
            <Border Background="#40E8F5E9" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text=" " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CantidadGuardados}" FontWeight="Bold" Foreground="Green" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            
            <Border Background="#40C8E6C9" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Aplicados: " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CantidadAplicados}" FontWeight="Bold" Foreground="DarkGreen" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            
            <Border Background="#40FFCDD2" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sin Coincidencia: " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CantidadSinCoincidencia}" FontWeight="Bold" Foreground="Red" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            
            <Border Background="#40FFE0B2" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Multiples Creditos: " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CantidadMultiplesCreditos}" FontWeight="Bold" Foreground="DarkOrange" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            
            <Border Background="#40FFF3E0" CornerRadius="4" Padding="8,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Errores: " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CantidadErrores}" FontWeight="Bold" Foreground="OrangeRed" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- DataGrid con columnas según plantilla Fiduciaria -->
        <!-- Background MUY transparente: 40 (25%) para ver imagen de fondo claramente -->
        <DataGrid Grid.Row="2" Margin="16,0,16,16" ItemsSource="{Binding Pagos}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Background="#40FFFFFF"
                  materialDesign:DataGridAssist.CellPadding="6 3 3 3"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="4"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  FontSize="10"
                  x:Name="dgPagos"
                  CellEditEnding="DataGrid_CellEditEnding"
                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                  SelectedItem="{Binding PagoSeleccionado}">
            
            <!-- Estilo para colorear filas según estado (colores suaves semitransparentes) -->
            <!-- Opacidad MUY reducida: 60 (37%) para máxima transparencia pero manteniendo tinte de color -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                    <Style.Triggers>
                        <!-- BLOQUEADO tiene prioridad máxima - Verde suave -->
                        <DataTrigger Binding="{Binding Bloqueado}" Value="True">
                            <Setter Property="Background" Value="#66C8E6C9" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <!-- Estados normales (solo si NO está bloqueado) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Bloqueado}" Value="False" />
                                <Condition Binding="{Binding Estado}" Value="Aplicado" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#66E8F5E9" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Estado}" Value="NoCoincide">
                            <Setter Property="Background" Value="#66FFE0B2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Estado}" Value="Corregido">
                            <Setter Property="Background" Value="#66FFF9C4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Estado}" Value="ConError">
                            <Setter Property="Background" Value="#66FFCCBC" />
                        </DataTrigger>
                        <!-- Validado = amarillo claro (listo para procesar) -->
                        <DataTrigger Binding="{Binding Estado}" Value="Validado">
                            <Setter Property="Background" Value="#66FFF8E1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>


            <DataGrid.Columns>
                <!-- ESTADO (primera columna con color) -->
                <DataGridTemplateColumn Header="ESTADO" Width="75" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#9E9E9E" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EstadoTexto}" FontWeight="SemiBold" FontSize="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Estado}" Value="Aplicado">
                                                <Setter Property="Foreground" Value="Green" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="NoCoincide">
                                                <Setter Property="Foreground" Value="DarkOrange" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="Corregido">
                                                <Setter Property="Foreground" Value="DarkOrange" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="ConError">
                                                <Setter Property="Foreground" Value="Crimson" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="Importado">
                                                <Setter Property="Foreground" Value="Gray" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- A: ID (gris) - Últimos 4 dígitos del GUID -->
                <DataGridTextColumn Header="ID" Binding="{Binding IdCorto, Mode=OneWay}" Width="45" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#BDBDBD" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- B: CEDULA (amarillo) - La correcta, corregida por gestores -->
                <DataGridTextColumn Header="CEDULA" Binding="{Binding CedulaCorrecta}" Width="90" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#FFEB3B" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- C: BANCO (amarillo) - La cédula con la que entró el pago -->
                <DataGridTextColumn Header="BANCO" Binding="{Binding CedulaCliente}" Width="90" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#FFEB3B" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- NEW: TITULAR (amarillo) -->
                <DataGridTextColumn Header="TITULAR" Binding="{Binding Titular}" Width="150" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#FFEB3B" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>

                <!-- ============================================================ -->
                <!-- COLUMNAS MOVIDAS AL INICIO (SOLICITUD USUARIO) -->
                <!-- ============================================================ -->
                
                <!-- CUOTA (morado claro) -->
                <DataGridTextColumn Header="CUOTA" Binding="{Binding CuotaActual}" Width="45">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#E1BEE7" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- CUOTAS PEND (morado claro) -->
                <DataGridTextColumn Header="PEND" Binding="{Binding CuotasPendientes}" Width="40">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#E1BEE7" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- DÍAS MORA (morado claro, texto rojo si > 30) -->
                <DataGridTextColumn Header="D.MORA" Binding="{Binding DiasMora}" Width="50">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#E1BEE7" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TieneMoraAlta}" Value="True">
                                    <Setter Property="Foreground" Value="Red" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- PROX CUOTA (morado claro) -->
                <DataGridTextColumn Header="PROX CUOTA" Binding="{Binding FechaProximaCuota, StringFormat=dd/MM/yyyy}" Width="80">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#E1BEE7" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- EXCEDENTE (verde claro) - MOVIDO AQUÍ -->
                <DataGridTextColumn Header="EXCEDENTE" Binding="{Binding Excedente, StringFormat=N0}" Width="70">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#C8E6C9" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- CRÉDITOS (morado claro) -->
                <DataGridTextColumn Header="CRÉDITOS" Binding="{Binding ListaCreditos}" Width="120">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#E1BEE7" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- D: MONTO (amarillo) -->
                <DataGridTextColumn Header="MONTO" Binding="{Binding Monto, StringFormat=$ {0:N0}}" Width="80" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#FFEB3B" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- E: FECHA CONSIG (amarillo) -->
                <DataGridTextColumn Header="FECHA CONSIG" Binding="{Binding FechaConsignacion, StringFormat=dd/MM/yyyy}" Width="80" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#FFEB3B" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- F: CONVENIO (amarillo) -->
                <DataGridTextColumn Header="CONVENIO" Binding="{Binding Convenio}" Width="140" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#FFEB3B" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- G: N° APROBACIÓN (amarillo) -->
                <DataGridTextColumn Header="N° APROB" Binding="{Binding NumeroAprobacion}" Width="70" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#FFEB3B" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- MOVIDO AL INICIO -->
                
                <!-- H: RESULTADO (azul claro) -->
                <DataGridTextColumn Header="RESULTADO" Binding="{Binding Resultado}" Width="70" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#B3E5FC" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- I: ERROR (azul claro) -->
                <DataGridTextColumn Header="ERROR" Binding="{Binding Error}" Width="110" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#B3E5FC" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- J: ASUMIDO (azul claro) -->
                <DataGridTextColumn Header="ASUMIDO" Binding="{Binding Asumido}" Width="60" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#B3E5FC" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- K: SALDO P (azul claro) -->
                <DataGridTextColumn Header="SALDO P" Binding="{Binding SaldoP}" Width="60" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#B3E5FC" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- L: OBSERVACIÓN (azul claro) -->
                <DataGridTextColumn Header="OBSERVACIÓN" Binding="{Binding Observacion}" Width="110" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#B3E5FC" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- M: CC (azul claro) - EDITABLE Y DOS VIAS -->
                <DataGridTextColumn Header="CC" Binding="{Binding CC, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80" IsReadOnly="False">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#B3E5FC" />
                            <Setter Property="FontSize" Value="9" />
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="ToolTip" Value="EDITABLE: Ingrese Consecutivo (CC) para calcular pagos"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                         <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="#E0F7FA"/>
                         </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <!-- N: FECHA APLICACIÓN (azul claro) -->
                <DataGridTextColumn Header="FECHA APLIC" Binding="{Binding FechaAplicacion}" Width="80">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#B3E5FC" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- O: CREDITO (azul claro) -->
                <DataGridTextColumn Header="CREDITO" Binding="{Binding Credito}" Width="85">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#B3E5FC" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- P: CAPITAL (verde claro) -->
                <DataGridTextColumn Header="CAPITAL" Binding="{Binding Capital, StringFormat=N0}" Width="65">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#C8E6C9" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- Q: INTERESES (verde claro) -->
                <DataGridTextColumn Header="INTERESES" Binding="{Binding Intereses, StringFormat=N0}" Width="65">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#C8E6C9" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- R: CARGOS (verde claro) -->
                <DataGridTextColumn Header="CARGOS" Binding="{Binding Cargos, StringFormat=N0}" Width="55">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#C8E6C9" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- S: MORA (verde claro) -->
                <DataGridTextColumn Header="MORA" Binding="{Binding Mora, StringFormat=N0}" Width="50">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#C8E6C9" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- S2: CONDONACION (verde claro más oscuro) -->
                <DataGridTextColumn Header="CONDONA" Binding="{Binding Condonacion, StringFormat=N0}" Width="60">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#A5D6A7" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- T: TOTAL APLICADO (verde claro) -->
                <DataGridTextColumn Header="TOTAL APLIC" Binding="{Binding TotalAplicado, StringFormat=N0}" Width="75">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#C8E6C9" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                
                <!-- EXCEDENTE MOVIDO AL INICIO -->
                
                <!-- CUADRA - Indica si TOTAL APLICADO == MONTO -->
                <DataGridTemplateColumn Header="CUADRA" Width="60">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#B2DFDB" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TextoCuadra}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Gray" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstaCuadrado}" Value="True">
                                                <Setter Property="Foreground" Value="Green" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NoCuadra}" Value="True">
                                                <Setter Property="Foreground" Value="Red" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- AB: BLOQ - Indica si el pago está bloqueado (candado) -->
                <DataGridTemplateColumn Header="🔒" Width="35">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#FFCDD2" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="ToolTip" Value="Bloqueado (no modificable)" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                       ToolTip="{Binding UsuarioBloqueo, StringFormat='Bloqueado por: {0}'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Bloqueado}" Value="True">
                                                <Setter Property="Text" Value="🔒" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Panel de Actividad en Tiempo Real -->
        <Border Grid.Row="3" Background="#DD1A1A2E" CornerRadius="6" Margin="16,4,16,4" Padding="8,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Status line - siempre visible -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x26A1;" Foreground="#4FC3F7" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Actividad: " Foreground="#90CAF9" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#E0E0E0" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="900" />
                    <TextBlock Text=" | " Foreground="#616161" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Text="{Binding Pagos.Count, StringFormat='Pagos: {0}'}" Foreground="#81C784" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                
                <!-- Log expandible -->
                <Expander Grid.Row="1" Header="Ver log detallado" Foreground="#9E9E9E" FontSize="10" IsExpanded="False" Margin="0,2,0,0">
                    <ListBox ItemsSource="{Binding LogEntries}" MaxHeight="120" 
                             Background="Transparent" BorderBrush="Transparent" 
                             Foreground="#B0BEC5" FontSize="10" FontFamily="Consolas"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <TextBlock Text="{Binding}" TextWrapping="NoWrap" Foreground="#B0BEC5" FontSize="10" Padding="2,1" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Expander>
            </Grid>
        </Border>

        <!-- Buttons - Area con fondo semitransparente para mejor visibilidad -->
        <Border Grid.Row="4" Background="#40FFFFFF" CornerRadius="8" Margin="16,0,16,16" Padding="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    
                    <!-- GRUPO: ACCIONES OPERATIVAS (Amarillo/Naranja) -->
                    <Button Content="📋 Pendientes" Command="{Binding CargarPagosPendientesCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"
                            Background="#FFB74D" Foreground="White" BorderBrush="{x:Null}">
                        <Button.ToolTip>
                            <TextBlock>Cargar pagos pendientes de procesar (no bloqueados)</TextBlock>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="📜 Historial" Command="{Binding VerHistorialCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"
                            Background="#FFA726" Foreground="White" BorderBrush="{x:Null}">
                        <Button.ToolTip>
                            <TextBlock>Ver historial de pagos procesados en el último mes</TextBlock>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="Ver Errores" Command="{Binding VerErroresCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0" 
                            Background="#F44336" Foreground="White" BorderBrush="{x:Null}"/>

                    <!-- SEPARADOR -->
                    <Border Width="2" Background="#99000000" Margin="8,4" />

                    <!-- GRUPO: PROCESAMIENTO (Azul Institucional) -->
                    <!-- BLUE: #1A237E (Deep Blue) or #1565C0 (Blue) -->
                    <Button Content="Desglose XEO" Command="{Binding ConsultarDesgloseXeoCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"
                            Background="#0277BD" Foreground="White" BorderBrush="{x:Null}">
                        <Button.ToolTip>
                            <TextBlock>Consulta el desglose de pagos aplicados (Capital, Intereses, Cargos, Mora) desde XEO</TextBlock>
                        </Button.ToolTip>
                    </Button>
                    <Button Command="{Binding ConciliarPagosCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="Conciliar pagos importados contra movimientos CC de la API"
                            Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckAll" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Conciliar API" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- SEPARADOR -->
                    <Border Width="2" Background="#99000000" Margin="8,4" />

                    <!-- GRUPO: EXPORTACIÓN (Verde Institucional) -->
                    <!-- GREEN: #2E7D32 -->
                    <Button Content="📋 Exportar Fiduciaria" Command="{Binding ExportarFiduciariaConFechasCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"
                            Background="#2E7D32" Foreground="White" BorderBrush="{x:Null}">
                        <Button.ToolTip>
                            <TextBlock>Bloquea y exporta pagos conciliados a Excel para fiduciaria (6 Mar → Hoy)</TextBlock>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="Acum. Fiduciaria" Command="{Binding ExportAcumulativoCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"
                            Background="#388E3C" Foreground="White" BorderBrush="{x:Null}">
                        <Button.ToolTip>
                            <TextBlock>Agrega pagos APLICADOS al archivo acumulativo semanal para reporte fiduciaria</TextBlock>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="CSV (BI)" Command="{Binding ExportGoogleSheetsCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#43A047" Foreground="White" BorderBrush="{x:Null}">
                        <Button.ToolTip>
                            <TextBlock>Exporta CSV simplificado para Google Sheets (Inteligencia de Negocios)</TextBlock>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
